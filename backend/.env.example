# =============================================================================
# ICDS-H ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy to .env and replace secrets before any non-local deployment.
# =============================================================================

DATABASE_URL=sqlite:///./icds_h.db
# DATABASE_URL=mysql+pymysql://root:password@db:3306/icds_h

SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_EMAIL=admin@icds-h.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Dr. Aris Thorne
ADMIN_CLEARANCE=5

ANALYST_EMAIL=analyst@icds-h.com
ANALYST_PASSWORD=Analyst@1234
CLINICAL_EMAIL=clinical@icds-h.com
CLINICAL_PASSWORD=Clinical@1234

DATASET_REPLAY_MODE=False
REPLAY_INTERVAL_SECONDS=4

LIVE_CAPTURE_ENABLED=False
AUTO_RESPONSE_ENABLED=False
AUTO_RESPONSE_MIN_SEVERITY=HIGH

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
